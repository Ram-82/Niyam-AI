# ============================================================
# Niyam AI - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# In development, only JWT_SECRET_KEY is needed (others have
# safe defaults). In production, all marked "REQUIRED" must be set.
# ============================================================

# ---- Environment ----
# "development" = MockDB fallback, relaxed validation, dev codes in API
# "production"  = real DB required, enforces all secrets
ENVIRONMENT=development

# ---- Supabase (PostgreSQL) ----
# REQUIRED in production. Optional in dev (MockDB used instead).
# Get these from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ---- JWT ----
# REQUIRED in production. In dev, an ephemeral random key is generated.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-change-this-in-production

# ---- Email (Resend) ----
# Optional. If not set, emails are skipped (codes shown in API response).
# Get your API key from: https://resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key
SENDER_EMAIL=noreply@niyam.ai
# FRONTEND_URL is used for links in emails (dashboard, verify page)
FRONTEND_URL=http://localhost:3000

# ---- AI Extraction (Anthropic Claude) ----
# Optional. Enables AI-assisted extraction for messy/low-confidence invoices.
# Get your API key from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://niyam-ai-zncb.vercel.app

# ---- OCR ----
TESSERACT_PATH=/usr/bin/tesseract
OCR_TIMEOUT=30
